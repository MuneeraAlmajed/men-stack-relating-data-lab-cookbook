<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Community Recipes</title>
</head>

<body>

    <h1>Community Recipes</h1>

    <% if (recipes.length > 0) { %>

        <ul>
            <% recipes.forEach((recipe) => { %>

                <li>
                    <h2><%= recipe.name %></h2>
<p>By <%= user.username %></p>                </li>

            <% }); %>
        </ul>

    <% } else { %>

        <p>There are no recipes yet.</p>

    <% } %>

    <a href="/users">Back to Community</a>

</body>

</html>