<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Pantry</title>
  </head>
  <body>
    <h1>Welcome to my Pantry</h1>
    <a href="/users/<%=user._id%>/foods/new">Add new item</a>
    <h1>My Pantry</h1>
    <% if (pantry.length > 0) { %>

  <% pantry.forEach((food) => { %>

    <p>
      <%= food.name %>
      <a href="/users/<%= user._id %>/foods/<%= food._id %>">
        View
      </a>
      <br>
      <a href="/users/<%= user._id %>/foods/<%= food._id %>/edit">Edit</a>
    </p>

    <form
        action="/users/<%= user._id %>/foods/<%= food._id %>?_method=DELETE" method="POST">
          <button type="submit">Delete</button>
    </form>


  <% }); %>

<% } else { %>

  <p>There are no items in this pantry.</p>

<% } %>


    
  </body>
</html>