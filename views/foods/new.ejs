<h1>Add New Food</h1>

<form action="/users/<%= user._id %>/foods" method="POST">

  <label for="username">Name:</label>
  <input
    type="text"
    id="name"
    name="name"
    required
    />
  

  <button type="submit">Add Food</button>

</form>

<a href="/users/<%= user._id %>/foods">Back to Pantry</a>